.animal-action-menu {
    position: absolute; height: 140px;
    overflow: visible;
}
.animal-action-list { width: 100%; height: 140px; justify-content: space-between; }
.animal-option, .animal-action-nav, .accessory-back {
    background-image: none;
    margin: 0; padding: 0;
    -unity-text-align: middle-center;
}
.animal-option {
    height: 44px; flex-shrink: 0; width: 100%;
    border-radius: 22px; border-width: 2px;
    border-color: rgb(84, 98, 67); background-color: rgb(255, 250, 231);
    color: rgb(53, 70, 44); font-size: 16px; -unity-font-style: bold;
}
.animal-option:hover { background-color: rgb(239, 242, 213); }
.animal-option.animal-option-selected {
    color: rgb(255, 251, 230); border-color: rgb(49, 69, 45);
    background-color: rgb(70, 96, 59);
}
.yard-root .animal-option:focus, .yard-root .accessory-back:focus { border-color: rgb(159, 111, 48); }
.selection-marker {
    display: none; position: absolute; left: 9px; top: 14px;
    width: 12px; height: 12px; color: rgb(255, 217, 129); rotate: 90deg;
}
.animal-option-selected .selection-marker { display: flex; }
.animal-menu-pointer {
    position: absolute; width: 16px; height: 10px;
    color: rgb(74, 91, 62);
}
.animal-action-nav {
    position: absolute; width: 52px; height: 44px;
    align-items: center; justify-content: center;
    border-width: 2px; border-radius: 21px;
    border-color: rgb(59, 81, 72); background-color: rgb(235, 246, 224);
}
.animal-action-nav:hover { background-color: rgb(219, 240, 223); }
.animal-action-nav:active { background-color: rgb(170, 216, 208); }
.yard-root .animal-action-nav:focus { border-color: rgb(131, 100, 45); }
.animal-nav-arrow { width: 21px; height: 15px; color: rgb(54, 81, 73); }
.point-down { rotate: 180deg; }
.decoration-preview {
    height: 140px; width: 100%; padding: 8px;
    align-items: center; justify-content: space-between;
    border-radius: 19px; border-width: 2px;
    border-color: rgb(95, 111, 79); background-color: rgb(255, 250, 231);
}
.accessory-slot {
    width: 36px; height: 36px; border-radius: 10px; border-width: 1px;
    border-color: rgb(191, 201, 169); background-color: rgb(230, 236, 211);
    align-items: center; justify-content: center;
}
.accessory-slot > * { width: 26px; height: 26px; color: rgb(93, 115, 77); }
.accessory-empty {
    margin: 0; padding: 0; color: rgb(63, 79, 52); font-size: 14px;
    -unity-text-align: middle-center;
}
.accessory-back {
    width: 100%; height: 44px; border-width: 1px; border-radius: 16px;
    color: rgb(51, 75, 48); font-size: 14px; -unity-font-style: bold;
    border-color: rgb(179, 195, 153); background-color: rgb(230, 239, 209);
}
.pet-feedback { position: absolute; width: 70px; height: 48px; }
.heart-left, .heart-center, .heart-right { position: absolute; color: rgb(205, 91, 83); }
.heart-left { left: 1px; top: 18px; width: 17px; height: 17px; rotate: -15deg; }
.heart-center { left: 18px; top: 2px; width: 28px; height: 28px; rotate: 5deg; }
.heart-right { left: 45px; top: 9px; width: 16px; height: 16px; rotate: 17deg; }
.pet-full .heart-center { color: rgb(185, 81, 97); }
.pet-gain {
    position: absolute; left: 34px; top: 28px;
    margin: 0; padding: 0 5px; height: 19px;
    border-radius: 9px; border-width: 1px; border-color: rgb(181, 114, 78);
    background-color: rgb(255, 246, 219); color: rgb(136, 73, 55);
    font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center;
}
